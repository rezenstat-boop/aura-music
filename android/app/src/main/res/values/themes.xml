<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch theme: solid brand background, acts as the native splash screen
         while the WebView boots. windowBackground is replaced by the activity
         layout immediately after launch. -->
    <style name="Theme.AuraMusic" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">#0d0b14</item>
        <item name="android:navigationBarColor">#0d0b14</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
